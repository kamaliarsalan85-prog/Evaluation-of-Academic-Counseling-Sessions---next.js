# PostgreSQL connection string (used by Prisma Client at runtime)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/counseling_eval?schema=public"

# Direct PostgreSQL connection string for migrations (optional when not using a pooler)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/counseling_eval?schema=public"

# Secret used to sign/verify session cookies & CSRF tokens (min 32 random chars in production)
AUTH_SECRET="CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_SECRET"

# Optional one-time secret required on /admin/setup to create the initial Super Admin
ADMIN_BOOTSTRAP_SECRET=""

# Public application URL (used for metadata and callback URLs)
APP_URL="http://localhost:3000"

# Runtime environment (development | production | test)
NODE_ENV="development"

# Optional: allow embedded local PGlite server in development when DATABASE_URL is unset
ALLOW_EMBEDDED_DEV_POSTGRES="true"
