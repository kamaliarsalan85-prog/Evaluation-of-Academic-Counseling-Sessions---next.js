# PostgreSQL connection string (used by Prisma Client at runtime)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/counseling_eval?schema=public"

# Direct PostgreSQL connection string for migrations (defaults to DATABASE_URL on startup if omitted)
DIRECT_URL=""

# Secret used to sign/verify session tokens & sensitive operational checks (min 32 random chars in production)
AUTH_SECRET="CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_SECRET"

# Optional one-time secret required on /admin/setup to create the initial Super Admin
ADMIN_BOOTSTRAP_SECRET=""

# Public application URL on your host/domain (used for metadata and origin checks)
APP_URL="https://your-domain.com"

# Listening port (automatically provided by PaaS hosts like Liara, Render, Railway)
PORT="3000"

# Runtime environment (development | production)
NODE_ENV="production"

# Set to "false" on production hosts (only for local development without external Postgres)
ALLOW_EMBEDDED_DEV_POSTGRES="false"
