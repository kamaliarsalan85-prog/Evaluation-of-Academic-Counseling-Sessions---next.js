{
  "name": "counseling-evaluation-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "dev:next": "next dev -p 3000 -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "node scripts/start-production.mjs",
    "postinstall": "prisma generate",
    "clean": "rm -rf .next dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/lib/__tests__/pure-logic.test.ts src/lib/__tests__/db-integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@google/genai": "^2.4.0",
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jalaali-js": "^1.2.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jalaali-js": "^2.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "15",
    "pg": "^8.23.1",
    "postcss": "^8.5.33",
    "prisma": "6.19.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
